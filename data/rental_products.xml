<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Monthly Rental Product -->
    <record id="product_monthly_rental" model="product.product">
        <field name="name">Monthly Rental</field>
        <field name="default_code">MONTHLY_RENTAL</field>
        <field name="type">service</field>
        <field name="list_price">0.00</field>
        <field name="recurring_invoice">True</field>
        <field name="categ_id" ref="product.product_category_all"/>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>  <!-- Clear all taxes -->
    </record>

    <!-- Security Deposit Product -->
    <record id="product_security_deposit" model="product.product">
        <field name="name">Security Deposit</field>
        <field name="default_code">SECURITY_DEPOSIT</field>
        <field name="type">service</field>
        <field name="list_price">0.00</field>
        <field name="categ_id" ref="product.product_category_all"/>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>  <!-- Clear all taxes -->
    </record>

    <!-- Advance Rent Product -->
    <record id="product_advance_rent" model="product.product">
        <field name="name">Advance Rent</field>
        <field name="default_code">ADVANCE_RENT</field>
        <field name="type">service</field>
        <field name="list_price">0.00</field>
        <field name="categ_id" ref="product.product_category_all"/>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>  <!-- Clear all taxes -->
    </record>
</odoo>