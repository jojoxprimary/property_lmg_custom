<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Custom rental order cancellation email template -->
        <record id="mail_template_sale_cancellation" model="mail.template">
            <field name="name">Rental Order: Cancellation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} {{ object.type_name }} Cancelled (Ref {{ object.name or 'n/a' }})</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Dear <t t-out="object.partner_id.name or ''">Customer</t>,</p>
    
    <p>Please be advised that your Quotation <strong><t t-out="object.name or ''">0000000</t></strong> has been cancelled. Therefore, you should not be charged further for this order.</p>
    
    <p>If the cancellation is due to a price revision, kindly wait while we send you another quotation.</p>
    
    <p>Best regards,<br/>
    <t t-out="object.user_id.name or object.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        
    </data>
</odoo>