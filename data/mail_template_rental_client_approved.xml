<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module', '=', 'property_lmg_custom'), ('name', '=', 'mail_template_rental_client_approved')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>
        <record id="mail_template_rental_client_approved" model="mail.template">
            <field name="name">Rental: Client Approved Proposal</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Rental Proposal {{ object.name }} - Confirmed by Client</field>
            <field name="email_from">{{ 'Primary Homes Incorporated &lt;noreply@theprimarygroup.com.ph&gt;' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hello,</p>
    <p>
        This is to confirm that the client has reviewed and signed rental proposal
        <strong><t t-out="object.name">SO001</t></strong>.
    </p>
    <ul>
        <li><strong>Customer:</strong> <t t-out="object.partner_id.name">Customer Name</t></li>
        <li><strong>Salesperson:</strong> <t t-out="object.user_id.name">Salesperson</t></li>
    </ul>
    <p>
        You may now proceed with the next internal processing steps.
    </p>
    <p style="margin-top: 16px;">
        <a t-att-href="object.get_base_url() + '/odoo/rental/' + str(object.id)"
           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
            View Quotation
        </a>
    </p>
    <p style="margin-top: 16px;">
        Best regards,<br/>
        Primary Homes Incorporated
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
