<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal HTML View for Rental Proposals -->
    <template id="rental_proposal_portal_content" name="Rental Proposal Portal View">
        <div class="o_portal_my_doc">
            <div class="text-center mb-4">
                <t t-set="unit_product" t-value="sale_order.property_unit_product_id"/>
                <h3 style="color:#875A7B; font-weight:bold;">
                    RENT PROPOSAL
                    <t t-if="unit_product and unit_product.product_tmpl_id.space_use">
                        ( <span t-esc="unit_product.product_tmpl_id.space_use.capitalize()" />)
                    </t>
                </h3>
            </div>

            <div class="container">
                <!-- Customer &amp; Sales Info -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;"> Customer Information </h5>
                        <div t-field="sale_order.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}' />
                    </div>
                    <div class="col-md-6">
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;"> Sales Information </h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td style="width: 30%;"><strong>Date</strong></td>
                                <td><span t-field="sale_order.date_order" t-options='{"widget": "date"}' /></td>
                            </tr>
                            <tr>
                                <td><strong>Leasing Officer</strong></td>
                                <td><span t-field="sale_order.user_id.name" /></td>
                            </tr>
                            <tr>
                                <td><strong>Address</strong></td>
                                <td>
                                    <span t-field="sale_order.company_id.street" /><br />
                                    <span t-if="sale_order.company_id.street2" t-field="sale_order.company_id.street2" /><br t-if="sale_order.company_id.street2" />
                                    <span t-field="sale_order.company_id.city" />, <span t-field="sale_order.company_id.state_id.name" />
                                    <span t-field="sale_order.company_id.zip" /><br />
                                    <span t-field="sale_order.company_id.country_id.name" />
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Phone</strong></td>
                                <td><span t-field="sale_order.user_id.mobile" /></td>
                            </tr>
                            <tr>
                                <td><strong>Email</strong></td>
                                <td><span t-field="sale_order.user_id.email" /></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Rent Details -->
                <t t-set="unit_product" t-value="sale_order.property_unit_product_id"/>
                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;" class="mt-4"> Rent Details </h5>
                <table class="table table-bordered mt-3">
                    <tbody>
                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Address</strong></td>
                            <td>
                                <t t-if="unit_product">
                                    <span t-esc="unit_product.name or '-'" />
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Building Name</strong></td>
                            <td>
                                <t t-if="unit_product">
                                    <span t-esc="unit_product.name or '-'" />
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Unit Number</strong></td>
                            <td>
                                <t t-if="unit_product">
                                    <span t-esc="unit_product.name or '-'" />
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                        <tr t-if="unit_product and unit_product.product_tmpl_id.floor">
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Floor</strong></td>
                            <td><span t-out="unit_product.product_tmpl_id.floor" />th</td>
                        </tr>
                        <tr t-if="unit_product and unit_product.product_tmpl_id.area">
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Area</strong></td>
                            <td><span t-out="unit_product.product_tmpl_id.area" /> sqm</td>
                        </tr>
                        <tr t-if="unit_product and unit_product.product_tmpl_id.space_use">
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Space Use</strong></td>
                            <td><span t-esc="unit_product.product_tmpl_id.space_use.capitalize()" /></td>
                        </tr>
                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Move-in/Move-out Date</strong></td>
                            <td>
                                <span t-esc="sale_order.rental_start_date.strftime('%B %d, %Y') if sale_order.rental_start_date else ''" /> to
                                <span t-esc="sale_order.rental_return_date.strftime('%B %d, %Y') if sale_order.rental_return_date else ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Rent Term</strong></td>
                            <td><span t-esc="int(round(sale_order.duration_days / 30))" /> month(s)</td>
                        </tr>
                        <t t-if="unit_product and unit_product.product_tmpl_id.hand_over_condition_ids">
                            <tr>
                                <td style="width: 30%; background-color: #f8f9fa;"><strong>Hand Over Condition</strong></td>
                                <td>
                                    <t t-foreach="unit_product.product_tmpl_id.hand_over_condition_ids" t-as="cond">
                                        <span t-esc="cond.name" /><t t-if="!cond_last"><br/></t>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <t t-if="unit_product and unit_product.product_tmpl_id.rent_inclusion_ids">
                            <tr>
                                <td style="width: 30%; background-color: #f8f9fa;"><strong>Rent Inclusions</strong></td>
                                <td>
                                    <t t-foreach="unit_product.product_tmpl_id.rent_inclusion_ids" t-as="incl">
                                        <span t-esc="incl.name" /><t t-if="!incl_last"><br/></t>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <t t-if="unit_product and unit_product.product_tmpl_id.rent_exclusion_ids">
                            <tr>
                                <td style="width: 30%; background-color: #f8f9fa;"><strong>Rent Exclusions</strong></td>
                                <td>
                                    <t t-foreach="unit_product.product_tmpl_id.rent_exclusion_ids" t-as="excl">
                                        <span t-esc="excl.name" /><t t-if="!excl_last"><br/></t>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Requirements Before Move-in</strong></td>
                            <td>
                                <t t-if="unit_product and unit_product.product_tmpl_id.requirements_before_movein">
                                    <span t-out="unit_product.product_tmpl_id.requirements_before_movein" />
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Rent Rate -->
                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;" class="mt-4"> Rent Rate </h5>
                <table class="table table-bordered mt-3">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="width: 40%;">Description</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Taxes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="sale_order.order_line" t-as="line">
                            <tr>
                                <td style="background-color: #f8f9fa;">
                                    <t t-set="lines" t-value="line.name.split('\n')" />
                                    <strong><span t-esc="lines[0]" /></strong>
                                    <t t-if="len(lines) > 1">
                                        <br />
                                        <t t-foreach="lines[1:]" t-as="desc_line">
                                            <em><span t-esc="desc_line" /></em><br />
                                        </t>
                                    </t>
                                </td>
                                <td class="text-end"><span t-field="line.price_unit" /></td>
                                <td class="text-end"><span t-esc="', '.join(line.tax_id.mapped('name')) if line.tax_id else '-'" /></td>
                                <td class="text-end">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}' />
                                </td>
                            </tr>
                        </t>
                        <tr><td colspan="4" style="border: none !important; padding: 5px;"></td></tr>
                    </tbody>
                </table>

                <!-- Totals -->
                <table class="table table-bordered mt-0" style="width: 60%; margin-left: auto;">
                    <tbody>
                        <tr>
                            <td style="background-color: #f8f9fa;" class="text-start"><strong>Subtotal:</strong></td>
                            <td class="text-end">
                                <span t-field="sale_order.amount_untaxed" t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}' />
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #f8f9fa;" class="text-start"><strong>Taxes:</strong></td>
                            <td class="text-end">
                                <span t-field="sale_order.amount_tax" t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}' />
                            </td>
                        </tr>
                        <tr style="background-color: #875A7B; color: white;">
                            <td class="text-start"><h5 class="mb-0"><strong>Total:</strong></h5></td>
                            <td class="text-end"><h5 class="mb-0"><strong><span t-field="sale_order.amount_total" t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}' /></strong></h5></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Terms and Conditions -->
                <div class="mt-4">
                    <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;"> Terms and Conditions </h5>
                    <div style="font-size: 12px; padding: 10px; background-color: #f8f9fa; border: 1px solid #dee2e6; margin-top: 10px;">
                        <div style="margin: 5px 0;">
                            <ol style="margin: 0 0 10px 18px; padding: 0;">
                                <li>Advance rent payment is non-refundable should the tenant not push through with unit rental.</li>
                                <li>There will be a 5% increment in the rental increase annually unless another agreement will be reached between tenant and lessee</li>
                                <li>1 month non-payment of rent shall be subject for eviction.</li>
                                <li>Leasing officers are not allowed to accept any form of payments unless post-dated cheques.</li>
                                <li>Payments should be made only through authorized payment channels of Primaryhomes Inc.</li>
                            </ol>
                            <p style="margin: 0 0 6px 0;">Here are the official bank accounts of Primaryhomes Inc.</p>
                            <table class="table table-sm table-bordered" style="font-size: 12px; margin-bottom: 10px;">
                                <thead>
                                    <tr>
                                        <th>Account Name</th>
                                        <th>Account Number</th>
                                        <th>Bank / Branch</th>
                                        <th>Swift Code</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>PRIMARYHOMES, INC</td>
                                        <td>00-344-001571-2</td>
                                        <td>BDO – NORTH MANDAUE</td>
                                        <td>BNORPHMM</td>
                                    </tr>
                                    <tr>
                                        <td>PRIMARYHOMES, INC</td>
                                        <td>9101-0035-98</td>
                                        <td>BPI – MANALILI</td>
                                        <td>BOPIPHMM</td>
                                    </tr>
                                </tbody>
                            </table>
                            <p style="margin: 0;">
                                Once payments have been made, kindly email your proof of payment to: <br />
                                <span style="font-weight: bold;">Rent@primaryhomes.com</span> or <span style="font-weight: bold;">gbsaquilon@primaryhomes.com</span>
                            </p>
                        </div>
                    </div>
                </div>

                <section t-if="sale_order.signature" id="signature" name="Signature">
                    <div class="row mt-4" name="signature">
                        <div t-attf-class="#{'col-3' if report_type != 'html' else 'col-sm-7 col-md-4'} ms-auto text-center">
                            <h5>Signature</h5>
                            <img t-att-src="image_data_uri(sale_order.signature)" style="max-height: 6rem; max-width: 100%;" />
                            <p t-field="sale_order.signed_by" />
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </template>


</odoo>
