<?xml version="1.0" encoding="utf-8"?>
<odoo>    
    <!-- Add Sales Order column and hide Pay Now -->
    <template id="portal_my_invoices_custom" 
              name="Custom Invoice Portal View" 
              inherit_id="account.portal_my_invoices">
        
        <!-- Add Sales Order column header after Invoice # -->
        <xpath expr="//thead/tr[@class='active']/th[@name='invoice_number']" position="after">
            <th name="sales_order">Sales Order</th>
        </xpath>
        
        <!-- Add Sales Order data in each row -->
        <xpath expr="//t[@t-foreach='invoices']//tr/td[1]" position="after">
            <td>
                <t t-set="invoice" t-value="invoice_data['invoice']"/>
                <t t-if="invoice.invoice_origin">
                    <span t-esc="invoice.invoice_origin"/>
                </t>
                <t t-else="">
                    <span class="text-muted">-</span>
                </t>
            </td>
        </xpath>
        
    </template>
</odoo>