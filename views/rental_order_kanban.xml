        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_kanban"/>
        <field name="arch" type="xml">

            <!-- Remove the entire Late / Pickup / Return span -->
            <xpath expr="//span[@t-if='record.next_action_date.value']" position="replace"/>

        </field>
    </record>

</odoo>
