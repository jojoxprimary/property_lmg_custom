<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal HTML View -->
    <template id="rent_proposal_portal_content" name="Rental Proposal Portal View">
        <div class="o_portal_my_doc">
            <div class="text-center mb-4">
                <h3 style="color:#875A7B; font-weight:bold;">RENT PROPOSAL</h3>
            </div>
            
            <!-- Your portal content here -->
            <div class="container">
                <!-- Customer & Sales Info -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;">
                            Customer Information
                        </h5>
                        <div t-field="sale_order.partner_id" 
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                    </div>
                    <div class="col-md-6">
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;">
                            Sales Information
                        </h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td style="width: 30%;"><strong>Date</strong></td>
                                <td><span t-field="sale_order.date_order" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Leasing Officer</strong></td>
                                <td><span t-field="sale_order.user_id.name"/></td>
                            </tr>
                            <tr>
                            <td><strong>Address</strong></td>
                                <td>
                                    <!-- Option 1: Simple address display -->
                                    <span t-field="sale_order.company_id.street"/><br/>
                                    <span t-if="sale_order.company_id.street2" t-field="sale_order.company_id.street2"/><br t-if="sale_order.company_id.street2"/>
                                    <span t-field="sale_order.company_id.city"/>, 
                                    <span t-field="sale_order.company_id.state_id.name"/> 
                                    <span t-field="sale_order.company_id.zip"/><br/>
                                    <span t-field="sale_order.company_id.country_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Phone</strong></td>
                                <td><span t-field="sale_order.user_id.mobile"/></td>
                            </tr>
                            <tr>
                                <td><strong>Email</strong></td>
                                <td><span t-field="sale_order.user_id.email"/></td>
                            </tr>

                        </table>
                    </div>
                </div>

                <!-- Rent Details -->
                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;" class="mt-4">
                    Rent Details
                </h5>

                <!-- Get the first order line (assuming rental property is always first or most relevant) -->
                <t t-set="property_line" t-value="sale_order.order_line[:1]"/>

                <table class="table table-bordered mt-3">
                    <tbody>
                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Address</strong></td>
                            <td>
                                <t t-if="property_line and property_line.product_id.categ_id">
                                    <t t-set="address_parts" t-value="property_line.product_id.categ_id.complete_name.split('/')"/>
                                    <!-- Get the second part (index 1) if it exists, which should be the address -->
                                    <span t-esc="address_parts[1].strip() if len(address_parts) > 1 else '-'"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Building Name</strong></td>
                            <td>
                                <t t-if="property_line and property_line.product_id.categ_id">
                                    <!-- Get the third part (index 2) if it exists, which should be the building name -->
                                    <t t-set="address_parts" t-value="property_line.product_id.categ_id.complete_name.split('/')"/>
                                    <span t-esc="address_parts[2].strip() if len(address_parts) > 2 else property_line.product_id.categ_id.name"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Unit Number</strong></td>
                            <td>
                                <t t-if="property_line">
                                    <span t-field="property_line.product_id.name"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Move-in/Move-out Date</strong></td>
                            <td>
                                <span t-esc="sale_order.rental_start_date.strftime('%B %d, %Y') if sale_order.rental_start_date else ''"/>
                                to
                                <span t-esc="sale_order.rental_return_date.strftime('%B %d, %Y') if sale_order.rental_return_date else ''"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Rent Term</strong></td>
                            <td>
                                <span t-esc="int(round(sale_order.duration_days / 30))"/> month(s)
                                
                            </td>
                        </tr>

                        <!-- Loop through product attributes -->
                        <t t-if="property_line and property_line.product_id">
                            <t t-foreach="property_line.product_id.product_template_attribute_value_ids" t-as="attr_value">
                                <tr style="border-bottom: 1px solid #e6dee4ff;">
                                    <td style="width: 30%; padding: 8px; background-color: #f8f9fa;">
                                        <strong>
                                            <span t-field="attr_value.attribute_id.name"/>
                                        </strong>
                                    </td>
                                    <td>
                                        <span t-field="attr_value.name"/>
                                    </td>
                                </tr>
                            </t>
                        </t>

                        <tr>
                            <td style="width: 30%; background-color: #f8f9fa;"><strong>Requirements Before Move-in</strong></td>
                            <td>
                                <t t-if="property_line">
                                    <span t-field="property_line.product_id.description"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Rent Rate -->
                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;" class="mt-4">
                    Rent Rate
                </h5>
                <table class="table table-bordered mt-3">
                    <tbody>
                        <t t-foreach="sale_order.order_line" t-as="line">
                            <tr>
                                <td style="width: 30%; background-color: #f8f9fa;">
                                    <t t-set="lines" t-value="line.name.split('\n')"/>
                                    <strong><span t-esc="lines[0]"/></strong>
                                    <t t-if="len(lines) > 1">
                                        <br/>
                                        <t t-foreach="lines[1:]" t-as="desc_line">
                                            <em><span t-esc="desc_line"/></em><br/>
                                        </t>
                                    </t>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit"/>
                                </td>
                            </tr>
                        </t>
                        
                        <tr>
                            <td colspan="2" style="padding: 10px;"></td>
                        </tr>
                        
                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Subtotal:</strong></td>
                            <td class="text-end">
                                <span t-field="sale_order.amount_untaxed" 
                                      t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #f8f9fa;"><strong>Taxes:</strong></td>
                            <td class="text-end">
                                <span t-field="sale_order.amount_tax" 
                                      t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
                            </td>
                        </tr>
                        <tr style="background-color: #875A7B; color: white;">
                            <td><h5 class="mb-0"><strong>Total:</strong></h5></td>
                            <td class="text-end">
                                <h5 class="mb-0">
                                    <strong>
                                        <span t-field="sale_order.amount_total" 
                                              t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
                                    </strong>
                                </h5>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- TERMS AND CONDITIONS / NOTES SECTION -->
                <div class="mt-4">
                    <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;">
                        Terms and Conditions
                    </h5>
                    <div style="font-size: 12px; padding: 10px; background-color: #f8f9fa; border: 1px solid #dee2e6; margin-top: 10px;">
                        <div style="margin: 5px 0;">
                            <ol style="margin: 0 0 10px 18px; padding: 0;">
                                <li>Advance rent payment is non-refundable should the tenant not push through with unit rental.</li>
                                <li>There will be a 5% increment in the rental increase annually unless another agreement will be reached between tenant and lessee</li>
                                <li>3 months non-payment of rent shall be subject for eviction.</li>
                                <li>Leasing officers are not allowed to accept any form of payments.</li>
                                <li>Payments should be made only through authorized payment channels of Primaryhomes Inc.</li>
                            </ol>

                            <p style="margin: 0 0 6px 0;">Here are the official bank accounts of Primaryhomes Inc.</p>
                            <table class="table table-sm table-bordered" style="font-size: 12px; margin-bottom: 10px;">
                                <thead>
                                    <tr>
                                        <th>Account Name</th>
                                        <th>Account Number</th>
                                        <th>Bank / Branch</th>
                                        <th>Swift Code</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>PRIMARYHOMES, INC</td>
                                        <td>00-344-001571-2</td>
                                        <td>BDO – NORTH MANDAUE</td>
                                        <td>BNORPHMM</td>
                                    </tr>
                                    <tr>
                                        <td>PRIMARYHOMES, INC</td>
                                        <td>9101-0035-98</td>
                                        <td>BPI – MANALILI</td>
                                        <td>BOPIPHMM</td>
                                    </tr>
                                </tbody>
                            </table>

                            <p style="margin: 0;">
                                Once payments have been made, kindly email your proof of payment to:
                                <br/>
                                <span style="font-weight: bold;">Rent@primaryhomes.com</span>
                                or
                                <span style="font-weight: bold;">gbsaquilon@primaryhomes.com</span>
                            </p>
                        </div>
                    </div>
                </div>

                <section t-if="sale_order.signature" id="signature" name="Signature">
                    <div class="row mt-4" name="signature">
                        <div t-attf-class="#{'col-3' if report_type != 'html' else 'col-sm-7 col-md-4'} ms-auto text-center">
                            <h5>Signature</h5>
                            <img t-att-src="image_data_uri(sale_order.signature)" style="max-height: 6rem; max-width: 100%;"/>
                            <p t-field="sale_order.signed_by"/>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </template>

</odoo>