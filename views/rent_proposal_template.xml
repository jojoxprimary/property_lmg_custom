<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define new report action for Rental Quotation -->
    <record id="action_report_rental_quotation" model="ir.actions.report">
        <field name="name">Rental Quotation</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">property_lmg_custom.report_rental_quotation_document</field>
        <field name="report_file">property_lmg_custom.report_rental_quotation_document</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        
        <field name="print_report_name">
            "%s %s" % (
                (object.order_line[:1].product_id.name or "NoProduct"),
                (object.date_order.strftime("%Y-%m-%d") if object.date_order else "NoDate")
            )
        </field>
    </record>

    <!-- Main Report Template -->
    <template id="report_rental_quotation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h5 style="text-align: center; font-weight: bold;">
                        RENT PROPOSAL
                        </h5>
                        
                        <!-- Get the first order line (assuming rental property is always first or most relevant) -->
                        <t t-set="property_line" t-value="doc.order_line[:1]"/>
                        
                        <!-- CUSTOMER & ORDER INFO -->
                        <div class="row">
                            <div class="col-6">
                                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;">
                                    Customer Information
                                </h5>
                                <div t-field="doc.partner_id" 
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                            </div>
                            <div class="col-6">
                                <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px;">
                                    Sales Information
                                </h5>
                                <table class="table table-sm table-borderless" style="font-size: 12px;">
                                    <tr>
                                        <td style="width: 35%;"><strong>Date:</strong></td>
                                        <td><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Salesperson:</strong></td>
                                        <td><span t-field="doc.user_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Address:</strong></td>
                                        <td>
                                            <span t-field="doc.company_id.street"/><br/>
                                            <span t-if="doc.company_id.street2" t-field="doc.company_id.street2"/><br t-if="doc.company_id.street2"/>
                                            <span t-field="doc.company_id.city"/>, 
                                            <span t-field="doc.company_id.state_id.name"/> 
                                            <span t-field="doc.company_id.zip"/><br/>
                                            <span t-field="doc.company_id.country_id.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="doc.user_id.mobile">
                                        <td><strong>Phone:</strong></td>
                                        <td><span t-field="doc.user_id.mobile"/></td>
                                    </tr>
                                    <tr t-if="doc.user_id.email">
                                        <td><strong>Email:</strong></td>
                                        <td><span t-field="doc.user_id.email"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- INFO -->
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px; margin-top: 20px;">
                            Rent Details
                        </h5>

                        <table class="table table-sm mt-3" style="border: 1px solid #dee2e6; font-size: 12px">
                            <tbody> 
                                <!-- Address Row -->
                                <tr>
                                    <td style="width: 30%; background-color: #f8f9fa;"><strong>Address</strong></td>
                                    <td style="padding: 5px;">
                                        <t t-if="property_line and property_line.product_id.categ_id">
                                            <t t-set="address_parts" t-value="property_line.product_id.categ_id.complete_name.split('/')"/>
                                            <!-- Get the second part (index 1) if it exists, which should be the address -->
                                            <span t-esc="address_parts[1].strip() if len(address_parts) > 1 else '-'"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>

                                <!-- Building Name Row -->
                                <tr>
                                    <td style="width: 30%; background-color: #f8f9fa;"><strong>Building Name</strong></td>
                                    <td>
                                        <t t-if="property_line and property_line.product_id.categ_id">
                                            <!-- Get the third part (index 2) if it exists, which should be the building name -->
                                            <t t-set="address_parts" t-value="property_line.product_id.categ_id.complete_name.split('/')"/>
                                            <span t-esc="address_parts[2].strip() if len(address_parts) > 2 else property_line.product_id.categ_id.name"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>

                                <!-- Unit Number Row -->
                                <tr>
                                    <td style="width: 30%; background-color: #f8f9fa;"><strong>Unit Number</strong></td>
                                    <td>
                                        <t t-if="property_line">
                                            <span t-field="property_line.product_id.name"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>
                                
                                <!-- Move-in/Move-out Date Row -->
                                <tr>
                                    <td style="width: 30%; background-color: #f8f9fa;"><strong>Move-in/Move-out Date</strong></td>
                                    <td style="padding: 5px;">
                                        <span t-esc="doc.rental_start_date.strftime('%B %d, %Y') if doc.rental_start_date else ''"/>
                                        to
                                        <span t-esc="doc.rental_return_date.strftime('%B %d, %Y') if doc.rental_return_date else ''"/>
                                    </td>
                                </tr>

                                <!-- Rent Term Row -->
                                <tr>
                                    <td style="width: 30%; background-color: #f8f9fa;"><strong>Rent Term</strong></td>
                                    <td style="padding: 5px;">
                                       <span t-esc="round(doc.duration_days / 30, 1)"/> month(s)
                                    </td>
                                </tr>

                                <!-- Loop through product attributes -->
                                <t t-if="property_line and property_line.product_id">
                                    <t t-foreach="property_line.product_id.product_template_attribute_value_ids" t-as="attr_value">
                                        <tr style="border-bottom: 1px solid #e6dee4ff;">
                                            <td style="width: 30%; padding: 8px; background-color: #f8f9fa;">
                                                <strong>
                                                    <span t-field="attr_value.attribute_id.name"/>
                                                </strong>
                                            </td>
                                            <td style="padding: 5px;">
                                                <span t-field="attr_value.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <!-- Requirements Row -->
                                <tr>
                                    <td style="width: 30%; background-color: #f8f9fa;"><strong>Requirements Before Move-in</strong></td>
                                    <td>
                                        <t t-if="property_line">
                                            <span t-field="property_line.product_id.description"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- RENTAL ITEMS TABLE -->
                        <h5 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 5px; margin-top: 30px;">
                            Rent Rate
                        </h5>
                        <table class="table table-sm mt-3" style="border: 1px solid #dee2e6;">
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <tr style="border-bottom: 1px solid #e6dee4ff; font-size: 12px;">
                                        <td style="width: 30%;padding: 5px;">
                                            <span t-field="line.name" style="color: #494949ff;"/>
                                        </td>
                                        <td style="padding: 5px; text-align: right;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS SECTION -->
                        <div class="row justify-content-end mt-4">
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr style="font-size: 12px;">
                                        <td style="padding: 4px;"><strong>Subtotal:</strong></td>
                                        <td class="text-end" style="padding: 4px;">
                                            <span t-field="doc.amount_untaxed" 
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-size: 12px;">
                                        <td style="padding: 4px;"><strong>Taxes:</strong></td>
                                        <td class="text-end" style="padding: 4px;">
                                            <span t-field="doc.amount_tax" 
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-size: 15px;">
                                        <td style="padding: 6px;">
                                            <span style="margin: 0; color: #875A7B;">Total:</span>
                                        </td>
                                        <td class="text-end" style="padding: 5px;">
                                            <span style="margin: 0; color: #875A7B;">
                                                <span t-field="doc.amount_total" 
                                                    t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- SIGNATURE SECTION - Show if already signed -->
                        <section t-if="doc.signature" id="signature" name="Signature">
                            <div class="row mt-4" name="signature">
                                <div class="col-6">
                                    <div style="text-align: center;">
                                        <h5>Company Representative</h5>
                                        <p style="margin-top: 5px;">
                                            <strong>Name:</strong> <span t-field="doc.user_id.name"/><br/>
                                            <strong>Date:</strong> <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                                        </p>
                                    </div>
                                </div>
                                
                                <div class="col-6">
                                    <div style="text-align: center;">
                                        <h5>Customer Signature</h5>
                                        <img t-att-src="image_data_uri(doc.signature)" style="max-height: 3rem; max-width: 100%;"/>
                                        <p style="margin-top: 5px;">
                                            <strong>Name:</strong> <span t-field="doc.signed_by"/><br/>
                                            <strong>Date:</strong> <span t-field="doc.signed_on" t-options='{"widget": "datetime"}'/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Optional: Report without external layout (no header/footer) -->
    <template id="report_rental_quotation_document_no_layout">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-call="property_lmg_custom.report_rental_quotation_document"/>
            </t>
        </t>
    </template>
</odoo>