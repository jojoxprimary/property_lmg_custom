<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- MAIN RENTAL ORDER FORM CUSTOMIZATIONS -->
    <!-- ========================================== -->
    <record id="view_rental_order_form_inherit_substate" model="ir.ui.view">
        <field name="name">rental.order.form.substate.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_primary_form_view"/>
        <field name="arch" type="xml">

            <!-- ========================================== -->
            <!-- CUSTOM BUTTONS -->
            <!-- ========================================== -->
            <xpath expr="//header/*[1]" position="before">
                <!-- Submit for Review Button -->
                <button
                    name="action_send_for_review"
                    string="Submit for Review"
                    type="object"
                    class="btn-primary"
                    confirm="Are you sure you want to send this proposal for review?"
                    invisible="substate_name != 'Proposal'"
                />
                
                <!-- Send Proposal Button - Only for Rental Managers -->
                <button
                    name="action_send_proposal"
                    string="Send to Client"
                    type="object"
                    class="btn-primary"
                    invisible="substate_name != 'For Review'"
                    confirm="Are you sure you want to approve and send this proposal?"
                    groups="property_lmg_custom.group_rental_manager"
                />
            </xpath>

            <!-- Download Contract Button (after Create Invoice) -->
            <xpath expr="//header/button[@id='create_invoice']" position="after">
                <button
                    name="action_download_contract"
                    string="Download Contract"
                    type="object"
                    class="btn"
                    invisible="(not is_subscription and invoice_status != 'to invoice') or (is_subscription and (state != 'sale' or (next_invoice_date &gt; current_date and invoice_status != 'to invoice'))) or state != 'sale' or is_rental_order != True"
                />
            </xpath>

            <!-- Download Contract Button (after Create Invoice for Subscription) -->
            <xpath expr="//header/button[@id='create_invoice_sub']" position="after">
                <button
                    name="action_download_contract"
                    string="Download Contract"
                    type="object"
                    class="btn"
                    invisible="not (is_subscription and (state != 'sale' or (next_invoice_date &gt; current_date and invoice_status != 'to invoice'))) or state != 'sale' or is_rental_order != True"
                />
            </xpath>

            <!-- ========================================== -->
            <!-- HIDE/MODIFY DEFAULT BUTTONS -->
            <!-- ========================================== -->
            <!-- Hide Send by Email Button (Primary - in draft state) -->
            <xpath expr="//header/button[@id='send_by_email_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Send by Email Button (Secondary - in sent/sale state) -->
            <xpath expr="//header/button[@id='send_by_email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Remove btn-primary class from confirm button in sent state -->
            <xpath expr="//button[@name='action_confirm'][@id='action_confirm']" position="attributes">
                <attribute name="class">btn</attribute>
            </xpath>

            <!-- Hide Pickup Button -->
            <xpath expr="//header/button[@name='action_open_pickup']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Upsell Button -->
            <xpath expr="//header/button[@name='prepare_upsell_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Renew Button -->
            <xpath expr="//header/button[@name='prepare_renewal_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- ========================================== -->
            <!-- CUSTOM STATUS BADGES -->
            <!-- ========================================== -->
            <!-- Waiting for Client Signature Badge (for Proposal Sent) -->
            <xpath expr="//div[@name='button_box']" position="after">
                <div name="waiting_signature_pill" 
                     class="float-end badge rounded-pill fw-bold text-bg-info"
                     invisible="state != 'sent' or substate_name != 'Proposal Sent'">
                    Waiting for Client Signature
                </div>
            </xpath>

            <!-- ========================================== -->
            <!-- ADD SUBSATE FIELD -->
            <!-- ========================================== -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="substate_id" optional="hide"/>
            </xpath>

            <!-- ========================================== -->
            <!-- FORM READONLY CONTROLS -->
            <!-- ========================================== -->
            <!-- Make the entire sheet readonly when in For Review state -->
            <xpath expr="//sheet" position="attributes">
                <attribute name="readonly">substate_name == 'For Review'</attribute>
            </xpath>

            <!-- Make substate field readonly (non-clickable) -->
            <xpath expr="//field[@name='substate_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- ========================================== -->
            <!-- FIELD-LEVEL READONLY ATTRIBUTES -->
            <!-- ========================================== -->
            <!-- Customer -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath>

            <!-- Expiration/Validity Date -->
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath>
    
            <!-- Quotation/Order Date -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath>   

            <!-- Recurring Plan -->
            <xpath expr="//field[@name='plan_id']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath>

            <!-- Pricelist -->
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath> 

            <!-- Payment Terms -->
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath>

            <!-- Rental Start Date -->
            <xpath expr="//field[@name='rental_start_date']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath>

            <!-- Order Lines -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">is_for_manager_review == True or substate_name != 'Proposal'</attribute>
            </xpath>

            <!-- ========================================== -->
            <!-- DURATION DISPLAY CUSTOMIZATION -->
            <!-- ========================================== -->
            <!-- Change rental duration display from days to months -->
            <xpath expr="//label[@for='duration_days']" position="replace" optional="True">
                <label for="duration_months" string="Duration" invisible="not is_rental_order and not rental_start_date"/>
            </xpath>

            <!-- Replace duration days field with duration months -->
            <xpath expr="//div[hasclass('o_row')][field[@name='duration_days']]" position="replace" optional="True">
                <div class="o_row" invisible="not is_rental_order and not rental_start_date">
                    <field class="oe_inline" style="max-width: 3rem" name="duration_months" invisible="duration_months == 0" readonly="is_for_manager_review == True or substate_name != 'Proposal'"/>
                    <span invisible="duration_months != 1"> month </span>
                    <span invisible="duration_months in [0,1]"> months </span>
                    <span invisible="duration_months == 0 or remaining_hours == 0">and </span>
                    <field class="oe_inline" style="max-width: 2rem" name="remaining_hours" invisible="remaining_hours == 0" readonly="is_for_manager_review == True or substate_name != 'Proposal'"/>
                    <span invisible="remaining_hours != 1"> hour </span>
                    <span invisible="remaining_hours in [0,1]"> hours </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- HIDE UNWANTED BADGES -->
    <!-- ========================================== -->
    <record id="view_order_form_inherit_hide_rental_badges" model="ir.ui.view">
        <field name="name">sale.order.form.hide.rental.badges</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_primary_form_view"/>
        <field name="arch" type="xml">
            <!-- Hide Booked badge -->
            <xpath expr="//div[hasclass('badge')][hasclass('text-bg-success')][text()='Booked']" position="replace" optional="True"/>

            <!-- Hide Late Pickup badge -->
            <xpath expr="//div[hasclass('badge')][hasclass('text-bg-danger')][hasclass('float-end')][text()='Late Pickup']" position="replace" optional="True"/>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- SUBSCRIPTION VIEW CUSTOMIZATIONS -->
    <!-- ========================================== -->
    <!-- Override subscription quotation pill -->
    <record id="view_subscription_quotation_pill_override" model="ir.ui.view">
        <field name="name">subscription.quotation.pill.override</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='subscription_quotation_pill']" position="replace" optional="True">
                <div name="subscription_quotation_pill" class="float-end badge rounded-pill fw-bold text-bg-info"
                     invisible="subscription_state != '1_draft' or state not in ['draft', 'sent'] or substate_name != 'Rental Agreement Sent'">
                    Waiting for Client Signature
                </div>
            </xpath>
        </field>
    </record>

    <!-- Hide subscription state badges (In Progress, Churned, etc.) -->
    <record id="view_subscription_state_badge_hide" model="ir.ui.view">
        <field name="name">subscription.state.badge.hide</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <style>
                    div[name='subscription_state'] { display: none !important; }
                    .o_field_badge.text-danger { display: none !important; }
                    .o_field_badge.text-success { display: none !important; }
                </style>
            </xpath>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- SALES APP VIEW CUSTOMIZATIONS -->
    <!-- ========================================== -->
    <!-- Hide substate field in Sales app (only show in Rental app) -->
    <record id="view_order_form_hide_substate_sales" model="ir.ui.view">
        <field name="name">sale.order.form.hide.substate.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add is_rental_order field for visibility control -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_rental_order" invisible="1"/>
            </xpath>

            <!-- Add substate_id and hide it if not rental order -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="substate_id" invisible="not is_rental_order"/>
            </xpath>
        </field>
    </record>
   
</odoo>